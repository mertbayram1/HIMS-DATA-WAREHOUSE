# ============================================================
# HIMS (Hospital Information Management System)
# Konfigürasyon Template
# ============================================================
# UYARI: Bu dosyayı .env olarak kopyala ve değerleri güncelle
# Asla .env dosyasını repo'ya commit etme!
# ============================================================

# ============================================================
# DATABASE
# ============================================================
DATABASE_URL=sqlite:///./hospital.db
DATABASE_PATH=./hospital.db

# ============================================================
# API SERVER
# ============================================================
API_HOST=127.0.0.1
API_PORT=8001
API_RELOAD=true
API_LOG_LEVEL=info

# ============================================================
# CORS & SECURITY
# ============================================================
# Virgülle ayrılmış izin verilen origins
ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000

# JWT Secret (üretme: python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# ============================================================
# AUTHENTICATION
# ============================================================
# Demo kullanıcı credentials
DEMO_EMAIL=demo@hospital.com
DEMO_PASSWORD=Demo@123456

# ============================================================
# FRONTEND
# ============================================================
VITE_API_URL=http://127.0.0.1:8001/api
VITE_APP_TITLE=HIMS - Hastane Bilgi Yönetim Sistemi

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=./logs

# ============================================================
# DEVELOPMENT / PRODUCTION
# ============================================================
ENVIRONMENT=development
# ENVIRONMENT=production

# ============================================================
# DATABASE BACKUP
# ============================================================
BACKUP_DIR=./backups
BACKUP_ENABLED=true
BACKUP_INTERVAL_DAYS=7

# ============================================================
# EMAIL (İleride kullanım için)
# ============================================================
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@hospital.local

# ============================================================
# REPORTING
# ============================================================
REPORTS_DIR=./reports
ENABLE_DAILY_REPORT=true

# ============================================================
# ETL / DATA IMPORT
# ============================================================
CSV_IMPORT_DIR=./data/csv
ETL_LOG_LEVEL=INFO
ETL_BATCH_SIZE=1000
